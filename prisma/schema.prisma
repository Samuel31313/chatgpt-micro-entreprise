datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dossier {
  id        String   @id @default(cuid())
  sessionId String   @unique // ChatGPT conversation identifier

  // Identité
  firstName    String?
  lastName     String?
  dateOfBirth  String? // YYYY-MM-DD
  placeOfBirth String?
  nationality  String?

  // Activité
  activityType   String? // commercial | artisanal | liberal
  activityDesc   String?
  nafCode        String?
  enterpriseAddr String?

  // Options
  acreOption   Boolean @default(false)
  versementLib Boolean @default(false)

  // Paiement
  stripeSessionId     String? @unique
  stripePaymentStatus String? // pending | paid | failed
  amountCents         Int?

  // INPI
  inpiFormaliteId String? @unique
  inpiStatus      String? // draft | submitted | processing | accepted | rejected
  siretNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
}

model Document {
  id        String  @id @default(cuid())
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id])

  type           String  // id_document | domicile_proof | non_condamnation
  filePath       String?
  mimeType       String?
  fileName       String?
  status         String  @default("pending") // pending | valid | invalid
  validationNote String?

  createdAt DateTime @default(now())
}

// ─── Souscription compta / compte pro (sociétés existantes) ───

model Lead {
  id          String   @id @default(cuid())
  email       String
  phone       String?
  name        String?
  companyName String?
  siren       String?
  legalForm   String?
  answers     String // JSON QualificationAnswers
  route       String // creation | self_checkout | sales_meeting
  quote       String? // JSON Quote
  createdAt   DateTime @default(now())
}

model CustomOffer {
  id          String   @id @default(cuid())
  slug        String   @unique // identifiant public de l'offre (/offre/:slug)
  salesEmail  String
  salesName   String?
  email       String
  firstName   String?
  lastName    String?
  phone       String?
  companyName String?
  siren       String?
  message     String? // mot personnalisé du sales
  selection   String // JSON OfferSelection
  quote       String // JSON Quote
  status      String   @default("sent") // pending_approval | sent | rejected | expired
  approvedBy  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
