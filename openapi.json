{
  "openapi": "3.1.0",
  "info": {
    "title": "Assistant Juridique API",
    "description": "API backend pour le GPT assistant juridique : micro-entreprise, choix de statut, SASU, et souscription comptabilité / compte pro pour les sociétés existantes.",
    "version": "2.1.0"
  },
  "servers": [
    {
      "url": "https://chatgpt-micro-entreprise-production.up.railway.app"
    }
  ],
  "paths": {
    "/api/dossier": {
      "post": {
        "operationId": "saveDossier",
        "summary": "Sauvegarder ou mettre à jour un dossier micro-entreprise",
        "description": "Crée ou met à jour un dossier avec les informations collectées pour la micro-entreprise.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Identifiant unique de la conversation ChatGPT"
                  },
                  "first_name": {
                    "type": "string",
                    "description": "Prénom du créateur"
                  },
                  "last_name": {
                    "type": "string",
                    "description": "Nom de famille"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "description": "Date de naissance YYYY-MM-DD"
                  },
                  "place_of_birth": {
                    "type": "string",
                    "description": "Lieu de naissance"
                  },
                  "nationality": {
                    "type": "string",
                    "description": "Nationalité"
                  },
                  "activity_type": {
                    "type": "string",
                    "enum": [
                      "commercial",
                      "artisanal",
                      "liberal"
                    ],
                    "description": "Type d'activité"
                  },
                  "activity_desc": {
                    "type": "string",
                    "description": "Description de l'activité"
                  },
                  "naf_code": {
                    "type": "string",
                    "description": "Code APE/NAF"
                  },
                  "enterprise_addr": {
                    "type": "string",
                    "description": "Adresse de domiciliation"
                  },
                  "acre_option": {
                    "type": "boolean",
                    "description": "Option ACRE"
                  },
                  "versement_lib": {
                    "type": "boolean",
                    "description": "Option versement libératoire"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dossier sauvegardé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "dossier_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/dossier/{sessionId}": {
      "get": {
        "operationId": "getDossier",
        "summary": "Récupérer un dossier",
        "description": "Récupère toutes les informations d'un dossier existant.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifiant de session"
          }
        ],
        "responses": {
          "200": {
            "description": "Détails du dossier",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "dossier": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/dossier/{sessionId}/summary": {
      "get": {
        "operationId": "getDossierSummary",
        "summary": "Récapitulatif du dossier",
        "description": "Retourne un récapitulatif du dossier avant paiement.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifiant de session"
          }
        ],
        "responses": {
          "200": {
            "description": "Récapitulatif",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/naf/search": {
      "get": {
        "operationId": "searchNafCode",
        "summary": "Rechercher un code APE/NAF",
        "description": "Recherche les codes NAF pour une activité donnée.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Mots-clés de recherche"
          }
        ],
        "responses": {
          "200": {
            "description": "Résultats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/document/validate-url": {
      "post": {
        "operationId": "validateDocument",
        "summary": "Valider un document",
        "description": "Valide un document uploadé via son URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id",
                  "document_type",
                  "file_url"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Identifiant de session"
                  },
                  "document_type": {
                    "type": "string",
                    "enum": [
                      "id_document",
                      "domicile_proof",
                      "non_condamnation"
                    ],
                    "description": "Type de document"
                  },
                  "file_url": {
                    "type": "string",
                    "description": "URL du fichier"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Résultat de validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "document_id": {
                      "type": "string"
                    },
                    "is_valid": {
                      "type": "boolean"
                    },
                    "issues": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/payment/create": {
      "post": {
        "operationId": "createPayment",
        "summary": "Créer un lien de paiement",
        "description": "Génère un lien de paiement Stripe pour le dossier.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Identifiant de session"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lien de paiement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "payment_url": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/payment/status/{sessionId}": {
      "get": {
        "operationId": "checkPaymentStatus",
        "summary": "Vérifier le statut du paiement",
        "description": "Vérifie si le paiement Stripe a été complété.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifiant de session"
          }
        ],
        "responses": {
          "200": {
            "description": "Statut du paiement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "payment_status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/inpi/submit": {
      "post": {
        "operationId": "submitToInpi",
        "summary": "Soumettre le dossier à l'INPI",
        "description": "Soumet le dossier au Guichet Unique INPI après paiement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Identifiant de session"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Résultat de soumission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "formalite_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/inpi/status/{sessionId}": {
      "get": {
        "operationId": "checkInpiStatus",
        "summary": "Vérifier le statut INPI",
        "description": "Vérifie le statut de la soumission INPI et récupère le SIRET.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifiant de session"
          }
        ],
        "responses": {
          "200": {
            "description": "Statut INPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "inpi_status": {
                      "type": "string"
                    },
                    "siret": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sasu/checkout": {
      "post": {
        "operationId": "generateSasuCheckout",
        "summary": "Générer un lien checkout SASU LegalPlace",
        "description": "Génère un lien de checkout LegalPlace pour la création d'une SASU. Prend l'email du client et retourne l'URL de checkout avec les packs disponibles.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Email du client pour la création SASU"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Numéro de téléphone du client"
                  },
                  "company_name": {
                    "type": "string",
                    "description": "Nom de la société SASU"
                  },
                  "activity": {
                    "type": "string",
                    "description": "Description de l'activité de la SASU"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lien de checkout généré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "checkout_url": {
                      "type": "string"
                    },
                    "uniqid": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/micro-entreprise/checkout": {
      "post": {
        "operationId": "generateMicroEntrepriseCheckout",
        "summary": "Générer un lien checkout micro-entreprise LegalPlace",
        "description": "Génère un lien de checkout LegalPlace pour la création d'une micro-entreprise. Prend l'email du client et retourne l'URL de checkout avec les packs disponibles.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Email du client pour la création de micro-entreprise"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Numéro de téléphone du client"
                  },
                  "activity": {
                    "type": "string",
                    "description": "Description de l'activité de la micro-entreprise"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lien de checkout généré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "checkout_url": {
                      "type": "string"
                    },
                    "uniqid": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/offers/pricing": {
      "get": {
        "operationId": "getAccountingBankPricing",
        "summary": "Grille tarifaire comptabilité et compte pro",
        "description": "Retourne la grille LegalPlace HT : comptabilité (Essentiel / Elite par secteur, mensuel / annuel, options) et compte pro LP Pro (Basique / Premium / Ultime).",
        "responses": {
          "200": {
            "description": "Grille tarifaire",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "pricing": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/offers/qualify": {
      "post": {
        "operationId": "qualifyCompany",
        "summary": "Qualifier un prospect compta / compte pro",
        "description": "À appeler une fois les questions de qualification posées. Retourne route = creation (rediriger vers la création LegalPlace), self_checkout (devis + selection à passer à generateAccountingBankCheckout) ou sales_meeting (proposer le RDV via sales_meeting_url).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "answers"
                ],
                "properties": {
                  "contact": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "company_name": {
                        "type": "string"
                      },
                      "siren": {
                        "type": "string"
                      }
                    }
                  },
                  "answers": {
                    "type": "object",
                    "required": [
                      "company_status"
                    ],
                    "properties": {
                      "company_status": {
                        "type": "string",
                        "enum": [
                          "registered",
                          "in_progress",
                          "not_created"
                        ],
                        "description": "Société immatriculée, en cours de création, ou pas encore créée"
                      },
                      "legal_form": {
                        "type": "string",
                        "enum": [
                          "sasu",
                          "sas",
                          "eurl",
                          "sarl",
                          "sci",
                          "micro",
                          "ei",
                          "association",
                          "autre"
                        ]
                      },
                      "needs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "accounting",
                            "bank"
                          ]
                        }
                      },
                      "sector": {
                        "type": "string",
                        "enum": [
                          "base",
                          "independant",
                          "btp",
                          "diagnostic_immo",
                          "commerce",
                          "ecommerce",
                          "restauration",
                          "transport_vtc",
                          "autre"
                        ]
                      },
                      "activity": {
                        "type": "string"
                      },
                      "annual_revenue": {
                        "type": "number",
                        "description": "CA annuel HT en euros"
                      },
                      "employees": {
                        "type": "integer"
                      },
                      "vat_regime": {
                        "type": "string",
                        "enum": [
                          "franchise",
                          "quarterly",
                          "monthly",
                          "unknown"
                        ]
                      },
                      "eu_sales": {
                        "type": "boolean",
                        "description": "Ventes à distance vers des particuliers UE (OSS)"
                      },
                      "eu_imports": {
                        "type": "boolean",
                        "description": "Import de biens < 150 € vendus en UE (IOSS)"
                      },
                      "accounting_situation": {
                        "type": "string",
                        "enum": [
                          "no_accountant",
                          "new_fiscal_year",
                          "switching_accountant",
                          "late_closing"
                        ]
                      },
                      "english_speaking": {
                        "type": "boolean"
                      },
                      "wants_dedicated_accountant": {
                        "type": "boolean"
                      },
                      "preferred_frequency": {
                        "type": "string",
                        "enum": [
                          "monthly",
                          "yearly"
                        ]
                      },
                      "bank_users": {
                        "type": "integer"
                      },
                      "bank_cards": {
                        "type": "integer"
                      },
                      "transfers_per_month": {
                        "type": "integer"
                      },
                      "needs_invoicing": {
                        "type": "boolean"
                      },
                      "wants_call": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Résultat de qualification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "route": {
                      "type": "string",
                      "enum": [
                        "creation",
                        "self_checkout",
                        "sales_meeting"
                      ]
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "creation": {
                      "type": "object",
                      "properties": {
                        "legal_form": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        }
                      }
                    },
                    "selection": {
                      "type": "object",
                      "description": "Offre choisie. Au moins 'accounting' ou 'bank'.",
                      "properties": {
                        "accounting": {
                          "type": "object",
                          "required": [
                            "pack",
                            "sector",
                            "frequency"
                          ],
                          "properties": {
                            "pack": {
                              "type": "string",
                              "enum": [
                                "essentiel",
                                "elite"
                              ]
                            },
                            "sector": {
                              "type": "string",
                              "enum": [
                                "base",
                                "independant",
                                "btp",
                                "diagnostic_immo",
                                "commerce",
                                "ecommerce",
                                "restauration",
                                "transport_vtc"
                              ]
                            },
                            "frequency": {
                              "type": "string",
                              "enum": [
                                "monthly",
                                "yearly"
                              ]
                            },
                            "vat": {
                              "type": "string",
                              "enum": [
                                "none",
                                "quarterly",
                                "monthly"
                              ]
                            },
                            "oss": {
                              "type": "boolean"
                            },
                            "ioss": {
                              "type": "boolean"
                            },
                            "employees": {
                              "type": "integer",
                              "description": "Nombre de salariés (bulletins de paie / mois)"
                            }
                          }
                        },
                        "bank": {
                          "type": "object",
                          "required": [
                            "pack",
                            "frequency"
                          ],
                          "properties": {
                            "pack": {
                              "type": "string",
                              "enum": [
                                "basique",
                                "premium",
                                "ultime"
                              ]
                            },
                            "frequency": {
                              "type": "string",
                              "enum": [
                                "monthly",
                                "yearly"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "quote": {
                      "type": "object"
                    },
                    "bank_signup_url": {
                      "type": "string"
                    },
                    "upsell_hints": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sales_meeting_url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/offers/checkout": {
      "post": {
        "operationId": "generateAccountingBankCheckout",
        "summary": "Générer les liens de paiement compta / compte pro",
        "description": "Génère un lien de paiement Chargebee par abonnement (comptabilité et compte pro sont payés séparément), au prix de la grille officielle.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "selection"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "company_name": {
                    "type": "string"
                  },
                  "selection": {
                    "type": "object",
                    "description": "Offre choisie. Au moins 'accounting' ou 'bank'.",
                    "properties": {
                      "accounting": {
                        "type": "object",
                        "required": [
                          "pack",
                          "sector",
                          "frequency"
                        ],
                        "properties": {
                          "pack": {
                            "type": "string",
                            "enum": [
                              "essentiel",
                              "elite"
                            ]
                          },
                          "sector": {
                            "type": "string",
                            "enum": [
                              "base",
                              "independant",
                              "btp",
                              "diagnostic_immo",
                              "commerce",
                              "ecommerce",
                              "restauration",
                              "transport_vtc"
                            ]
                          },
                          "frequency": {
