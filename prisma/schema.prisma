datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dossier {
  id        String   @id @default(cuid())
  sessionId String   @unique // ChatGPT conversation identifier

  // Identité
  firstName    String?
  lastName     String?
  dateOfBirth  String? // YYYY-MM-DD
  placeOfBirth String?
  nationality  String?

  // Activité
  activityType   String? // commercial | artisanal | liberal
  activityDesc   String?
  nafCode        String?
  enterpriseAddr String?

  // Options
  acreOption   Boolean @default(false)
  versementLib Boolean @default(false)

  // Paiement
  stripeSessionId     String? @unique
  stripePaymentStatus String? // pending | paid | failed
  amountCents         Int?

  // INPI
  inpiFormaliteId String? @unique
  inpiStatus      String? // draft | submitted | processing | accepted | rejected
  siretNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
}

model Document {
  id        String  @id @default(cuid())
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id])

  type           String  // id_document | domicile_proof | non_condamnation
  filePath       String?
  mimeType       String?
  fileName       String?
  status         String  @default("pending") // pending | valid | invalid
  validationNote String?

  createdAt DateTime @default(now())
}

// Agent (IA ou partenaire) relié à un compte LegalPlace
model Agent {
  id               String  @id @default(cuid())
  name             String
  legalplaceEmail  String // Email du compte LegalPlace auquel l'agent est rattaché
  apiKeyHash       String  @unique // SHA-256 de la clé API (la clé en clair n'est jamais stockée)
  apiKeyPrefix     String // Début de la clé, pour l'identifier dans les logs
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders AgentOrder[]
}

// Demande de création de micro-entreprise par un agent (payée 5 €)
model AgentOrder {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  // pending_payment | paid | creating | created | failed | expired
  status String @default("pending_payment")

  // Données du créateur (JSON sérialisé, SQLite n'a pas de type Json)
  payload String

  // Paiement
  stripeSessionId String? @unique
  amountCents     Int
  paidAt          DateTime?

  // LegalPlace
  legalplaceUniqid String?
  legalplaceUrl    String?
  error            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}
