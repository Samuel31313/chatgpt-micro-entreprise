# Server
PORT=3000
APP_URL=https://your-domain.com
NODE_ENV=development

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_CENTS=6900

# INPI (Guichet Unique)
INPI_ENV=demo
INPI_USERNAME=your_inpi_username
INPI_PASSWORD=your_inpi_password

# Anthropic (document validation via Claude Vision)
ANTHROPIC_API_KEY=sk-ant-xxx

# API Key for GPT Actions authentication
GPT_API_KEY=your-secret-api-key-here

# Upload directory for documents
UPLOAD_DIR=./uploads

# Chargebee — comptabilité stand-alone (sociétés existantes)
CHARGEBEE_ACCOUNTING_SITE=lp-so-compta
# Optionnel : active les hosted pages API (prix sectoriels + remises sales). Sans clé : checkout par URL au prix catalogue.
CHARGEBEE_ACCOUNTING_API_KEY=
# Chargebee — compte pro LP Pro (tant que vide : redirection vers LPPRO_SIGNUP_URL)
CHARGEBEE_BANK_SITE=
CHARGEBEE_BANK_API_KEY=
CHARGEBEE_BANK_ITEM_PRICES={"basique_yearly":"","basique_monthly":"","premium_yearly":"","premium_monthly":"","ultime_yearly":"","ultime_monthly":"","opening_fee":""}
# Corrige un item_price_id du catalogue sans redéployer : {"TVA-mensuelle-EUR-Yearly":"..."}
CHARGEBEE_ITEM_PRICE_OVERRIDES={}
LPPRO_SIGNUP_URL=https://www.legalplace.fr/tarifs/compte-pro

# Outil sales (custom checkout sur /sales)
SALES_API_KEY=your-sales-key
SALES_MANAGER_API_KEY=your-manager-key
SALES_CALENDLY_URL=https://calendly.com/d/ck76-r2v-ytt/point-telephonique
